# Copy to .env and fill in. .env is gitignored.

# n8n Public API — Settings -> n8n API -> Create API key
N8N_API_URL=http://localhost:5678
N8N_API_KEY=

# Java service
JAVA_SERVICE_PORT=8080
# URL n8n (in Docker) uses to reach the Java service on the host
JAVA_SERVICE_URL_FROM_N8N=http://host.docker.internal:8080

# Vector store key shared by both workflows (must match in each)
VECTOR_MEMORY_KEY=hr_policies

# NOTE: Gemini and Anthropic API keys are NOT stored here.
# They live only inside n8n as credentials:
#   "Gemini - HR Agent"    (type: googlePalmApi)
#   "Anthropic - HR Agent" (type: anthropicApi)
