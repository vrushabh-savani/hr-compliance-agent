      "id": "38638458-7a5d-4d84-8219-60a0cc6bba98",
      "name": "Prepare Documents",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [280, 0],
      "parameters": {
        "jsCode": "// sourceDocument is the citation Claude must emit, so the bare filename\n// has to survive from the file read all the way into chunk metadata.\nreturn $input.all().map((item) => {\n  const filePath = item.binary?.data?.fileName ?? 'unknown.md';\n  return {\n    json: {\n      policyText: item.json.policyText,\n      docName: filePath.split('/').pop(),\n    },\n  };\n});"
      }
    },
    {
      "id": "d83a3a6c-a878-4c63-ad78-5ef096623c14",
      "name": "Simple Vector Store",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreInMemory",
      "typeVersion": 1.3,
      "position": [520, 0],
      "parameters": {
        "mode": "insert",
        "memoryKey": {
          "__rl": true,
          "mode": "id",
          "value": "hr_policies"
        },
        "clearStore": true,
        "embeddingBatchSize": 200
      }
    },
    {
      "id": "74e2e562-e8a8-468b-adb3-d8bdd5c0ed72",
      "name": "Embeddings Google Gemini",
